# Paste your real Atlas connection string here (not the example below) -
# from your screenshots: Database Access user, then Network Access has
# your IP whitelisted already. Get the full string from Atlas ->
# Connect to <cluster> -> Drivers -> Python, or reuse the one you already
# generated. Keep the actual password out of anything that isn't this
# file - this file is git-ignored on purpose (see .gitignore).
MONGODB_URL=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=king_saas

SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=academy_custom_message

# SMTP - a Gmail account works: enable 2-Step Verification, then create
# an App Password at myaccount.google.com/apppasswords (NOT your normal
# Gmail password, Google blocks that for SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
